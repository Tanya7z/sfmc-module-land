{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.lease",
  "name": "起租向导",
  "presentation": "form",
  "title": "起租向导",
  "state": {
    "name": { "type": "string", "default": "", "maxLength": 32 },
    "days": { "type": "number", "default": 7, "min": 1, "max": 90, "step": 1 }
  },
  "load": {
    "draft": {
      "service": "land.ui.leaseDraft",
      "input": { "playerId": "{{player.id}}" }
    }
  },
  "body": [
    {
      "id": "mode",
      "type": "info",
      "items": [
        "模式：{{data.draft.mode}}",
        "{{data.draft.description}}",
        "不填写名称时使用：{{data.draft.suggestedName}}"
      ]
    },
    {
      "id": "name",
      "type": "textField",
      "label": "庄园名称",
      "bind": "state.name"
    },
    {
      "id": "days",
      "type": "slider",
      "label": "租期天数",
      "bind": "state.days",
      "min": 1,
      "max": 90,
      "step": 1
    },
    {
      "id": "preview",
      "type": "button",
      "label": "预览并估价",
      "trigger": { "type": "action", "action": "preview" }
    },
    {
      "id": "create",
      "type": "button",
      "label": "确认起租",
      "tone": "primary",
      "trigger": { "type": "action", "action": "create" }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": { "type": "back" }
    }
  ],
  "actions": {
    "preview": {
      "call": {
        "service": "land.ui.previewLease",
        "input": { "playerId": "{{player.id}}", "days": "{{state.days}}" }
      },
      "onSuccess": [{ "effect": "message", "text": "{{result.message}}" }],
      "onError": [
        {
          "effect": "message",
          "text": "预览失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "create": {
      "confirm": {
        "title": "确认起租",
        "body": "确认按当前范围起租 {{state.days}} 天吗？"
      },
      "call": {
        "service": "land.ui.createLease",
        "input": {
          "playerId": "{{player.id}}",
          "name": "{{state.name}}",
          "days": "{{state.days}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "领地已创建：{{result.landId}}",
          "tone": "success"
        },
        { "effect": "replace", "to": "land.list" }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "起租失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
