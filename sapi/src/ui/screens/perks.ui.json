{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.perks",
  "name": "增益插槽",
  "presentation": "menu",
  "title": "庄园增益",
  "params": { "landId": { "type": "string", "required": true } },
  "load": {
    "perks": {
      "service": "land.ui.perks",
      "input": { "playerId": "{{player.id}}", "landId": "{{params.landId}}" }
    }
  },
  "body": [
    {
      "id": "tip",
      "type": "info",
      "items": ["休眠期增益自动暂停。"],
      "tone": "muted"
    },
    {
      "id": "perk-list",
      "type": "each",
      "source": "data.perks.items",
      "as": "perk",
      "template": [
        {
          "id": "perk-info",
          "type": "info",
          "items": ["{{perk.perkId}}：{{perk.statusText}}"]
        },
        {
          "id": "perk-toggle",
          "type": "button",
          "label": "{{perk.toggleText}} {{perk.perkId}}",
          "trigger": {
            "type": "action",
            "action": "toggle",
            "input": { "perkId": "{{perk.perkId}}" }
          }
        },
        { "id": "perk-divider", "type": "divider" }
      ]
    },
    {
      "id": "refresh",
      "type": "button",
      "label": "刷新",
      "trigger": { "type": "refresh" }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": { "type": "back" }
    }
  ],
  "actions": {
    "toggle": {
      "call": {
        "service": "land.ui.togglePerk",
        "input": { "playerId": "{{player.id}}", "landId": "{{params.landId}}" }
      },
      "onSuccess": [
        { "effect": "message", "text": "增益设置已更新", "tone": "success" },
        { "effect": "refresh" }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "更新失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
