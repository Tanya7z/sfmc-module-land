{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.teleport",
  "name": "公开地标",
  "presentation": "form",
  "title": "传送公开地标",
  "state": { "name": { "type": "string", "default": "" } },
  "body": [
    {
      "id": "tip",
      "type": "info",
      "items": ["输入公开庄园名称，传送时会支付门票。"],
      "tone": "muted"
    },
    {
      "id": "name",
      "type": "textField",
      "label": "庄园名称",
      "bind": "state.name"
    },
    {
      "id": "teleport",
      "type": "button",
      "label": "支付门票并传送",
      "tone": "primary",
      "trigger": { "type": "action", "action": "teleport" }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": { "type": "back" }
    }
  ],
  "actions": {
    "teleport": {
      "call": {
        "service": "land.ui.teleportByName",
        "input": { "playerId": "{{player.id}}", "name": "{{state.name}}" }
      },
      "onSuccess": [{ "effect": "close" }],
      "onError": [
        {
          "effect": "message",
          "text": "传送失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
