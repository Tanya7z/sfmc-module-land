{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.list",
  "name": "我的庄园",
  "presentation": "menu",
  "title": "我的庄园",
  "load": {
    "lands": {
      "service": "land.listByOwner",
      "input": { "ownerId": "{{player.id}}", "limit": 20 }
    }
  },
  "body": [
    {
      "id": "count",
      "type": "info",
      "items": ["名下契约：{{data.lands.lands.length}} 块"]
    },
    {
      "id": "land-list",
      "type": "each",
      "source": "data.lands.lands",
      "as": "land",
      "template": [
        {
          "id": "land-row",
          "type": "button",
          "label": "{{land.name}} [{{land.status}}]",
          "trigger": {
            "type": "navigate",
            "to": "land.detail",
            "params": { "landId": "{{land.id}}" }
          }
        }
      ],
      "empty": [
        {
          "id": "empty",
          "type": "info",
          "items": ["暂无有效契约，请使用起租向导。"],
          "tone": "muted"
        }
      ]
    },
    {
      "id": "refresh",
      "type": "button",
      "label": "刷新",
      "trigger": { "type": "refresh" }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": { "type": "back" }
    }
  ]
}
