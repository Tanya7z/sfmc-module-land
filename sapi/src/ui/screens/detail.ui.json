{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "land.detail",
  "name": "庄园详情",
  "presentation": "reactive",
  "title": "{{data.land.name}}",
  "params": { "landId": { "type": "string", "required": true } },
  "state": {
    "renewDays": {
      "type": "number",
      "default": 7,
      "min": 1,
      "max": 90,
      "step": 1
    },
    "expandLevel": {
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 5,
      "step": 1
    }
  },
  "load": {
    "land": {
      "service": "land.ui.detail",
      "input": { "playerId": "{{player.id}}", "landId": "{{params.landId}}" }
    }
  },
  "body": [
    {
      "id": "summary",
      "type": "info",
      "items": [
        "状态：{{data.land.status}} · 日租：{{data.land.dailyRent}}",
        "到期：{{data.land.leaseUntilText}} · Lv.{{data.land.level}}",
        "门票：{{data.land.ticketPrice}} · 公开：{{data.land.publicText}}"
      ]
    },
    {
      "id": "renew-days",
      "type": "slider",
      "label": "续租天数",
      "bind": "state.renewDays",
      "min": 1,
      "max": 90,
      "step": 1
    },
    {
      "id": "renew",
      "type": "button",
      "label": "确认续租（节操币）",
      "tone": "primary",
      "trigger": { "type": "action", "action": "renew" }
    },
    { "id": "renew-divider", "type": "divider" },
    {
      "id": "expand-level",
      "type": "slider",
      "label": "扩建等级",
      "bind": "state.expandLevel",
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "id": "preview-expand",
      "type": "button",
      "label": "预览扩建线框",
      "trigger": { "type": "action", "action": "previewExpand" }
    },
    {
      "id": "expand",
      "type": "button",
      "label": "确认扩建",
      "trigger": { "type": "action", "action": "expand" }
    },
    { "id": "perks-divider", "type": "divider" },
    {
      "id": "perks",
      "type": "button",
      "label": "增益插槽",
      "trigger": {
        "type": "navigate",
        "to": "land.perks",
        "params": { "landId": "{{params.landId}}" }
      }
    },
    {
      "id": "terminate",
      "type": "button",
      "label": "解除契约",
      "tone": "danger",
      "trigger": { "type": "action", "action": "terminate" }
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": { "type": "back" }
    }
  ],
  "actions": {
    "renew": {
      "call": {
        "service": "land.ui.renew",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "days": "{{state.renewDays}}"
        }
      },
      "onSuccess": [
        { "effect": "message", "text": "续租成功", "tone": "success" },
        { "effect": "refresh" }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "续租失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "previewExpand": {
      "call": {
        "service": "land.ui.previewExpand",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "level": "{{state.expandLevel}}"
        }
      },
      "onSuccess": [{ "effect": "message", "text": "{{result.message}}" }],
      "onError": [
        {
          "effect": "message",
          "text": "预览失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "expand": {
      "confirm": {
        "title": "确认扩建",
        "body": "确认扩建至所选等级并支付补差吗？"
      },
      "call": {
        "service": "land.ui.expand",
        "input": {
          "playerId": "{{player.id}}",
          "landId": "{{params.landId}}",
          "level": "{{state.expandLevel}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "扩建成功，补差 {{result.feeDiff}}",
          "tone": "success"
        },
        { "effect": "refresh" }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "扩建失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    },
    "terminate": {
      "confirm": {
        "title": "解除契约",
        "body": "确认解除？建筑保护将立即失效。",
        "confirmText": "确认解除",
        "danger": true
      },
      "call": {
        "service": "land.ui.terminate",
        "input": { "playerId": "{{player.id}}", "landId": "{{params.landId}}" }
      },
      "onSuccess": [
        { "effect": "message", "text": "契约已解除", "tone": "success" },
        { "effect": "replace", "to": "land.list" }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "解除失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
